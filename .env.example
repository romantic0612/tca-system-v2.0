# Copy this file to .env on the server and fill in real secrets.

HOST_PORT=8501
HOST=0.0.0.0
PORT=5000
DEBUG=false
TCA_FRONTEND_MODE=static

SECRET_KEY=replace-with-a-random-long-secret

# Database: use mysql for production Docker deployment; sqlite remains available for local tests.
DB_TYPE=mysql
DATABASE_PATH=/app/data/tca_system.db
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tca_system
MYSQL_USER=tca_user
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_HOST_PORT=3306

ECNU_LLM_ENABLED=true
ECNU_LLM_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
ECNU_LLM_API_KEY=replace-with-real-ecnu-api-key
ECNU_LLM_GUIDE_MODEL=ecnu-plus
ECNU_LLM_TUTOR_MODEL=ecnu-plus
ECNU_LLM_EVALUATOR_MODEL=ecnu-max
ECNU_LLM_TIMEOUT=20
