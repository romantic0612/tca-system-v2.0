# Copy this file to .env on the server and fill in real secrets.
# Do not commit .env.

# Docker / production defaults
HOST_PORT=8501
HOST=0.0.0.0
PORT=5000
DEBUG=false
TCA_FRONTEND_MODE=static

SECRET_KEY=replace-with-a-random-long-secret

# Database: use MySQL for production Docker deployment.
DB_TYPE=mysql
DATABASE_PATH=/app/data/tca_system.db
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=tca_system
MYSQL_USER=tca_user
MYSQL_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_HOST_PORT=3306

# For local development without MySQL, override these in your private .env:
# HOST=127.0.0.1
# DEBUG=true
# DB_TYPE=sqlite
# DATABASE_PATH=data/tca_system.db

# DeepSeek is OpenAI-compatible, so the existing ECNU_LLM_* names can be reused.
ECNU_LLM_ENABLED=true
ECNU_LLM_BASE_URL=https://api.deepseek.com/v1
ECNU_LLM_API_KEY=replace-with-your-deepseek-api-key
ECNU_LLM_GUIDE_MODEL=deepseek-chat
ECNU_LLM_TUTOR_MODEL=deepseek-chat
ECNU_LLM_EVALUATOR_MODEL=deepseek-chat
ECNU_LLM_TIMEOUT=20
